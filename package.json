{
  "name": "dsh-brake-pedal",
  "version": "0.2.0",
  "description": "制动踏板自检彩蛋：给长任务一场『6 脚全力制动测试』，支架随机断在第 2–6 脚（约 1/8 不裂），弹出一份虚构通报。纯表演，从不拦截真实停止动作；界面自带虚构声明，不指向任何真实厂商。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "client/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "easter-egg",
    "parody"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhanshenovo/dsh-brake-pedal.git"
  },
  "homepage": "https://github.com/zhanshenovo/dsh-brake-pedal#readme",
  "bugs": {
    "url": "https://github.com/zhanshenovo/dsh-brake-pedal/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "license": "MIT"
}
